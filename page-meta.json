  "defaults": {
    "status": "unknown",
    "badges": ["v6", "client"],
    "filters": ["gameplay"]
  },
  "rules": [
    {
      "match": "^/(fr-FR/)?mods-guides/",
      "badges": ["v6", "client", "mods"],
      "filters": ["mods"]
    },
    {
      "match": "^/(fr-FR/)?mods-guides/CobbleSafari/",
      "badges": ["v6", "client", "mods"],
      "filters": ["mods", "gameplay"]
    },
    {
      "match": "^/(fr-FR/)?mods-guides/CobbleSafari/cobblesafari$",
      "badges": ["v6", "client", "server", "mods"],
      "filters": ["mods", "server", "commands"]
    },
    {
      "match": "^/(fr-FR/)?pokemons-guides/gen-list/",
      "badges": ["v6", "client", "legendary"],
      "filters": ["legendary", "gameplay"]
    },
    {
      "match": "^/(fr-FR/)?pokemons-guides/myths-and-legends-legendaries$",
      "badges": ["v6", "client", "legendary"],
      "filters": ["legendary"]
    },
    {
      "match": "^/(fr-FR/)?installation$",
      "badges": ["v6", "client", "server", "support"],
      "filters": ["server", "gameplay"]
    },
    {
      "match": "^/(fr-FR/)?multiplayer-servers$",
      "badges": ["v6", "server", "admin"],
      "filters": ["server", "commands"]
    },
    {
      "match": "^/(fr-FR/)?settings/",
      "badges": ["v6", "client", "server", "admin"],
      "filters": ["server"]
    },
    {
      "match": "^/(fr-FR/)?report-a-bug$",
      "badges": ["v6", "support"],
      "filters": ["gameplay", "server"]
    },
    {
      "match": "^/(fr-FR/)?version-history$",
      "badges": ["v6"],
      "filters": ["gameplay"]
    }
  ],
  "pages": {}
}
